{
  "name": "@sovereignmap/core",
  "version": "0.1.2",
  "description": "Core Sovereign Map node client with privacy-preserving protocol, BFT consensus, and Island Mode",
  "keywords": [
    "sovereignmap",
    "depin",
    "federated-learning",
    "privacy",
    "bft"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./network": {
      "import": "./dist/network.js",
      "types": "./dist/network.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run wasm:copy",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:targeted": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "wasm:copy": "cp -r wasm dist/ 2>/dev/null || true"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@grpc/grpc-js": "^1.14.6",
    "@libp2p/tcp": "^11.0.29",
    "@multiformats/multiaddr": "^13.0.3",
    "eventemitter3": "^5.0.1",
    "libp2p": "^3.3.12",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@sovereignmap/consensus": "^0.1.2",
    "@sovereignmap/island": "^0.1.2",
    "@sovereignmap/privacy": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "@sovereignmap/privacy": {
      "optional": true
    },
    "@sovereignmap/consensus": {
      "optional": true
    },
    "@sovereignmap/island": {
      "optional": true
    }
  }
}
